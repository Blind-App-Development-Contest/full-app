{
    "include": [
        "backend"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "backend/venv",
        ".venv"
    ],
    "venvPath": "backend",
    "venv": "venv",
    "pythonVersion": "3.10",
    "pythonPlatform": "Darwin",
    "extraPaths": [
        "backend/venv/lib/python3.10/site-packages"
    ],
    "typeCheckingMode": "basic",
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none"
}